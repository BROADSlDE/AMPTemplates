    },
    {
        "UpdateStageName": "Mods Directory Creation",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "CreateDirectory",
        "UpdateSourceArgs": "{{$FullBaseDir}}mods",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "SteamCMD Game Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "SteamCMD",
        "UpdateSourceData": "10190",
        "UpdateSourceArgs": "10190",
        "ForceDownloadPlatform": "Windows",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "IW4x Launcher Download",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"cd \\\"{{$FullBaseDir}}\\\" && rm -f iw4x-launcher.tar.xz && wget -q -O iw4x-launcher.tar.xz \\\"https://github.com/iw4x/launcher/releases/download/v1.1.8-b.18/launcher-1.1.8-b.18-x86_64-linux-glibc.tar.xz\\\"\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "IW4x Launcher Extraction",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"cd \\\"{{$FullBaseDir}}\\\" && tar -xJf iw4x-launcher.tar.xz && chmod +x iw4x-launcher && rm -f iw4x-launcher.tar.xz\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "IW4x Client Installation",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"cd \\\"{{$FullBaseDir}}\\\" && ./iw4x-launcher\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Config File Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://cdn-repo.c7rs.com/AMPTemplates/call-of-dutymw2server.cfg",
        "UpdateSourceArgs": "server.cfg",
        "UpdateSourceTarget": "{{$FullBaseDir}}userraw",
        "OverwriteExistingFiles": false,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Initialise Wine",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"rm -rf \\\"{{$FullRootDir}}.wine\\\" >/dev/null 2>&1; WINEPREFIX=\\\"{{$FullRootDir}}.wine\\\" WINEARCH=win64 WINEDEBUG=-all /usr/bin/wineboot --init\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Configure Wine Prefix",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"cd \\\"{{$FullRootDir}}\\\" && rm -f winetricks && wget -q https://raw.githubusercontent.com/Winetricks/winetricks/refs/tags/20260125/src/winetricks && chmod +x winetricks && export WINEPREFIX=\\\"{{$FullRootDir}}.wine\\\" && export WINEARCH=win64 && ./winetricks -q vcrun2019 d3dcompiler_47 dxvk sound=disabled > winescript_log.txt 2>&1\"",
        "SkipOnFailure": false
    }
]
